<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 760 420" width="100%" height="auto" fill="none">
  <defs>
    <linearGradient id="arch-bg" x1="0" y1="0" x2="760" y2="420" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#0b1120"/>
      <stop offset="100%" stop-color="#162033"/>
    </linearGradient>
    <linearGradient id="gate-grad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0284c7"/>
      <stop offset="100%" stop-color="#0369a1"/>
    </linearGradient>
    <linearGradient id="faas-grad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#7c3aed"/>
      <stop offset="100%" stop-color="#6d28d9"/>
    </linearGradient>
  </defs>

  <rect width="760" height="420" rx="16" fill="url(#arch-bg)"/>

  <!-- Section Labels -->
  <text x="75" y="38" fill="#94a3b8" font-family="'Inter', system-ui, sans-serif" font-size="12" font-weight="600" text-anchor="middle">КЛИЕНТЫ</text>
  <text x="245" y="38" fill="#38bdf8" font-family="'Inter', system-ui, sans-serif" font-size="12" font-weight="600" text-anchor="middle">ВХОДНОЙ ШЛЮЗ</text>
  <text x="440" y="38" fill="#a78bfa" font-family="'Inter', system-ui, sans-serif" font-size="12" font-weight="600" text-anchor="middle">ВЫЧИСЛЕНИЯ (FAAS)</text>
  <text x="645" y="38" fill="#34d399" font-family="'Inter', system-ui, sans-serif" font-size="12" font-weight="600" text-anchor="middle">СЕРВИСЫ ДАННЫХ (BAAS)</text>

  <!-- Vertical Divider Lines -->
  <line x1="150" y1="20" x2="150" y2="400" stroke="#334155" stroke-dasharray="4 4" stroke-opacity="0.4"/>
  <line x1="340" y1="20" x2="340" y2="400" stroke="#334155" stroke-dasharray="4 4" stroke-opacity="0.4"/>
  <line x1="540" y1="20" x2="540" y2="400" stroke="#334155" stroke-dasharray="4 4" stroke-opacity="0.4"/>

  <!-- Left: Clients -->
  <g transform="translate(25, 70)">
    <rect width="100" height="60" rx="8" fill="#1e293b" stroke="#475569"/>
    <text x="50" y="30" fill="#f8fafc" font-family="'Inter', system-ui, sans-serif" font-size="11" font-weight="600" text-anchor="middle">Web App</text>
    <text x="50" y="46" fill="#94a3b8" font-family="'Inter', system-ui, sans-serif" font-size="10" text-anchor="middle">SPA / React</text>
  </g>

  <g transform="translate(25, 150)">
    <rect width="100" height="60" rx="8" fill="#1e293b" stroke="#475569"/>
    <text x="50" y="30" fill="#f8fafc" font-family="'Inter', system-ui, sans-serif" font-size="11" font-weight="600" text-anchor="middle">Mobile App</text>
    <text x="50" y="46" fill="#94a3b8" font-family="'Inter', system-ui, sans-serif" font-size="10" text-anchor="middle">iOS / Android</text>
  </g>

  <g transform="translate(25, 230)">
    <rect width="100" height="60" rx="8" fill="#1e293b" stroke="#475569"/>
    <text x="50" y="30" fill="#f8fafc" font-family="'Inter', system-ui, sans-serif" font-size="11" font-weight="600" text-anchor="middle">IoT / Sensors</text>
    <text x="50" y="46" fill="#94a3b8" font-family="'Inter', system-ui, sans-serif" font-size="10" text-anchor="middle">MQTT / REST</text>
  </g>

  <g transform="translate(25, 310)">
    <rect width="100" height="60" rx="8" fill="#1e293b" stroke="#475569"/>
    <text x="50" y="30" fill="#f8fafc" font-family="'Inter', system-ui, sans-serif" font-size="11" font-weight="600" text-anchor="middle">Webhooks</text>
    <text x="50" y="46" fill="#94a3b8" font-family="'Inter', system-ui, sans-serif" font-size="10" text-anchor="middle">Stripe / GitHub</text>
  </g>

  <!-- Connectors Client -> Gateway -->
  <path d="M125 100 L180 180" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4 2"/>
  <path d="M125 180 L180 190" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4 2"/>
  <path d="M125 260 L180 200" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4 2"/>
  <path d="M125 340 L180 210" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4 2"/>

  <!-- API Gateway Column -->
  <g transform="translate(185, 120)">
    <rect width="125" height="180" rx="12" fill="url(#gate-grad)" stroke="#38bdf8" stroke-width="2"/>
    <text x="62" y="35" fill="#ffffff" font-family="'Inter', system-ui, sans-serif" font-size="13" font-weight="700" text-anchor="middle">API Gateway</text>
    <line x1="15" y1="48" x2="110" y2="48" stroke="#ffffff" stroke-opacity="0.3"/>
    <text x="62" y="70" fill="#e0f2fe" font-family="'Inter', system-ui, sans-serif" font-size="10" text-anchor="middle">• Аутентификация</text>
    <text x="62" y="90" fill="#e0f2fe" font-family="'Inter', system-ui, sans-serif" font-size="10" text-anchor="middle">• Маршрутизация</text>
    <text x="62" y="110" fill="#e0f2fe" font-family="'Inter', system-ui, sans-serif" font-size="10" text-anchor="middle">• Rate Limiting</text>
    <text x="62" y="130" fill="#e0f2fe" font-family="'Inter', system-ui, sans-serif" font-size="10" text-anchor="middle">• CORS &amp; SSL/TLS</text>
    <text x="62" y="150" fill="#e0f2fe" font-family="'Inter', system-ui, sans-serif" font-size="10" text-anchor="middle">• Валидация JSON</text>
  </g>

  <!-- Connectors Gateway -> Functions -->
  <path d="M310 160 L380 100" stroke="#a78bfa" stroke-width="2"/>
  <path d="M310 200 L380 190" stroke="#a78bfa" stroke-width="2"/>
  <path d="M310 240 L380 280" stroke="#a78bfa" stroke-width="2"/>
  <path d="M310 260 L380 345" stroke="#a78bfa" stroke-width="2"/>

  <!-- FaaS Functions Column -->
  <g transform="translate(380, 70)">
    <rect width="125" height="55" rx="8" fill="url(#faas-grad)" stroke="#c4b5fd"/>
    <text x="20" y="35" fill="#f5f3ff" font-family="'Inter', system-ui, sans-serif" font-size="18" font-weight="bold">λ</text>
    <text x="45" y="27" fill="#ffffff" font-family="'Inter', system-ui, sans-serif" font-size="11" font-weight="600">AuthService</text>
    <text x="45" y="42" fill="#ddd6fe" font-family="'Inter', system-ui, sans-serif" font-size="9">JWT проверка</text>
  </g>

  <g transform="translate(380, 160)">
    <rect width="125" height="55" rx="8" fill="url(#faas-grad)" stroke="#c4b5fd"/>
    <text x="20" y="35" fill="#f5f3ff" font-family="'Inter', system-ui, sans-serif" font-size="18" font-weight="bold">λ</text>
    <text x="45" y="27" fill="#ffffff" font-family="'Inter', system-ui, sans-serif" font-size="11" font-weight="600">OrderProcessor</text>
    <text x="45" y="42" fill="#ddd6fe" font-family="'Inter', system-ui, sans-serif" font-size="9">Бизнес-логика</text>
  </g>

  <g transform="translate(380, 250)">
    <rect width="125" height="55" rx="8" fill="url(#faas-grad)" stroke="#c4b5fd"/>
    <text x="20" y="35" fill="#f5f3ff" font-family="'Inter', system-ui, sans-serif" font-size="18" font-weight="bold">λ</text>
    <text x="45" y="27" fill="#ffffff" font-family="'Inter', system-ui, sans-serif" font-size="11" font-weight="600">ImageResizer</text>
    <text x="45" y="42" fill="#ddd6fe" font-family="'Inter', system-ui, sans-serif" font-size="9">Конвертация WebP</text>
  </g>

  <g transform="translate(380, 330)">
    <rect width="125" height="55" rx="8" fill="url(#faas-grad)" stroke="#c4b5fd"/>
    <text x="20" y="35" fill="#f5f3ff" font-family="'Inter', system-ui, sans-serif" font-size="18" font-weight="bold">λ</text>
    <text x="45" y="27" fill="#ffffff" font-family="'Inter', system-ui, sans-serif" font-size="11" font-weight="600">NotifierService</text>
    <text x="45" y="42" fill="#ddd6fe" font-family="'Inter', system-ui, sans-serif" font-size="9">Email / Telegram</text>
  </g>

  <!-- Connectors Functions -> BaaS -->
  <path d="M505 100 L585 100" stroke="#34d399" stroke-width="2"/>
  <path d="M505 185 L585 185" stroke="#34d399" stroke-width="2"/>
  <path d="M505 275 L585 275" stroke="#34d399" stroke-width="2"/>
  <path d="M505 355 L585 355" stroke="#34d399" stroke-width="2"/>

  <!-- BaaS Column -->
  <g transform="translate(585, 70)">
    <rect width="135" height="55" rx="8" fill="#064e3b" stroke="#34d399"/>
    <text x="67" y="25" fill="#ffffff" font-family="'Inter', system-ui, sans-serif" font-size="11" font-weight="600" text-anchor="middle">Auth BaaS</text>
    <text x="67" y="42" fill="#a7f3d0" font-family="'Inter', system-ui, sans-serif" font-size="9" text-anchor="middle">Cognito / Auth0 / IAM</text>
  </g>

  <g transform="translate(585, 160)">
    <rect width="135" height="55" rx="8" fill="#064e3b" stroke="#34d399"/>
    <text x="67" y="25" fill="#ffffff" font-family="'Inter', system-ui, sans-serif" font-size="11" font-weight="600" text-anchor="middle">Serverless DB</text>
    <text x="67" y="42" fill="#a7f3d0" font-family="'Inter', system-ui, sans-serif" font-size="9" text-anchor="middle">DynamoDB / YDB / Aurora</text>
  </g>

  <g transform="translate(585, 250)">
    <rect width="135" height="55" rx="8" fill="#064e3b" stroke="#34d399"/>
    <text x="67" y="25" fill="#ffffff" font-family="'Inter', system-ui, sans-serif" font-size="11" font-weight="600" text-anchor="middle">Cloud Storage</text>
    <text x="67" y="42" fill="#a7f3d0" font-family="'Inter', system-ui, sans-serif" font-size="9" text-anchor="middle">AWS S3 / Yandex Object</text>
  </g>

  <g transform="translate(585, 330)">
    <rect width="135" height="55" rx="8" fill="#064e3b" stroke="#34d399"/>
    <text x="67" y="25" fill="#ffffff" font-family="'Inter', system-ui, sans-serif" font-size="11" font-weight="600" text-anchor="middle">Event Bus / Queues</text>
    <text x="67" y="42" fill="#a7f3d0" font-family="'Inter', system-ui, sans-serif" font-size="9" text-anchor="middle">EventBridge / SQS / SNS</text>
  </g>
</svg>
